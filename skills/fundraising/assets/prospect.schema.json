{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Investor prospect",
  "type": "object",
  "required": [
    "id",
    "round_id",
    "organization_name",
    "stage",
    "fit",
    "evidence_quality",
    "owners",
    "source_paths",
    "page"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$"
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "research",
        "queued",
        "contacted",
        "engaged",
        "diligence",
        "terms",
        "committed",
        "passed",
        "deferred"
      ]
    },
    "fit": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high"
      ]
    },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "unverified",
        "partial",
        "verified"
      ]
    },
    "check_claim": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_touch": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
