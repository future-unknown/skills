{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fundraising material",
  "type": "object",
  "required": [
    "id",
    "round_id",
    "name",
    "kind",
    "status",
    "owners",
    "reviewers",
    "source_paths",
    "page"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$"
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "memo",
        "deck",
        "demo",
        "data-room",
        "financial-model",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-review",
        "approved",
        "retired"
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "approval_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "circulation_boundary": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
