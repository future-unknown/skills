{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "probability",
    "impact",
    "owners",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "identified",
        "monitoring",
        "mitigating",
        "accepted",
        "closed"
      ]
    },
    "probability": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "current_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "response": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
