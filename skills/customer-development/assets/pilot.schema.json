{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer pilot",
  "type": "object",
  "required": [
    "id",
    "organization_name",
    "status",
    "workflow",
    "owners",
    "success_criteria",
    "source_paths",
    "page"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$"
    },
    "opportunity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "scoping",
        "confirmed",
        "active",
        "evaluating",
        "completed",
        "cancelled"
      ]
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "business_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "access_plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_plan": {
      "type": [
        "string",
        "null"
      ]
    },
    "commercial_form": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
