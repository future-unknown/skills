{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer opportunity",
  "type": "object",
  "required": [
    "id",
    "organization_name",
    "stage",
    "owners",
    "source_paths",
    "page"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$"
    },
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "identified",
        "discovery",
        "qualified",
        "proposal",
        "negotiation",
        "won",
        "lost",
        "parked"
      ]
    },
    "problem": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ]
    },
    "buyer": {
      "type": [
        "string",
        "null"
      ]
    },
    "urgency": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action_due": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
