{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer hypothesis",
  "type": "object",
  "required": [
    "id",
    "statement",
    "status",
    "owners",
    "evidence_for",
    "evidence_against",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "segment": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "untested",
        "testing",
        "supported",
        "weakened",
        "rejected",
        "parked"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_against": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "next_test": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
