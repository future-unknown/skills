{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discovery evidence",
  "type": "object",
  "required": [
    "id",
    "occurred_at",
    "method",
    "organization_name",
    "summary",
    "explicit_signals",
    "explicit_non_signals",
    "hypothesis_impact",
    "source_paths",
    "page"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "string",
      "enum": [
        "interview",
        "observation",
        "workflow-review",
        "survey",
        "other"
      ]
    },
    "opportunity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "organization_name": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "explicit_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "explicit_non_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hypothesis_impact": {
      "type": "string",
      "enum": [
        "supports",
        "weakens",
        "rejects",
        "inconclusive"
      ]
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
