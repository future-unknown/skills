{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Introduction",
  "type": "object",
  "required": [
    "id",
    "status",
    "requester_id",
    "target_contact_id",
    "owners",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "requested",
        "accepted",
        "sent",
        "meeting-scheduled",
        "completed",
        "declined"
      ]
    },
    "requester_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_contact_id": {
      "type": "string",
      "minLength": 1
    },
    "target_organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_update_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
