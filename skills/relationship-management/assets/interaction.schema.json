{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interaction",
  "type": "object",
  "required": [
    "id",
    "occurred_at",
    "direction",
    "channel",
    "participants",
    "summary",
    "explicit_signals",
    "explicit_non_signals",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "mutual"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "call",
        "meeting",
        "message",
        "event",
        "other"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "explicit_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "explicit_non_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "follow_up": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
