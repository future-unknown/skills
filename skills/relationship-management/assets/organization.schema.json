{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organization",
  "type": "object",
  "required": [
    "id",
    "name",
    "types",
    "status",
    "owners",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "unverified",
        "active",
        "inactive",
        "closed"
      ]
    },
    "website": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
