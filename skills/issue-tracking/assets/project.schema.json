{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "A short slug, such as billing-v2."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The project's name."
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "done",
        "cancelled"
      ],
      "description": "Where the project is."
    },
    "owner": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Who leads it: a link to their record when the team has a people directory, otherwise their name."
    },
    "starts_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "When it starts, if planned."
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "When it should be done, if there is a real date."
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "What the project is for, its scope and its decisions, in Markdown."
    }
  },
  "additionalProperties": false
}
