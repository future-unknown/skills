{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate",
  "type": "object",
  "required": [
    "id",
    "name",
    "role_id",
    "stage",
    "owners",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role_id": {
      "type": "string",
      "minLength": 1
    },
    "contact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "sourced",
        "contacted",
        "interested",
        "screening",
        "interviewing",
        "reference-check",
        "offer",
        "hired",
        "rejected",
        "withdrawn",
        "on-hold"
      ]
    },
    "source_claim": {
      "type": [
        "string",
        "null"
      ]
    },
    "consent_to_process": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "last_touch": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
