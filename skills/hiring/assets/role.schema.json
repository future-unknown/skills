{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hiring role",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "owners",
    "source_paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "page": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\[\\[[^\\]]+\\]\\]$",
      "description": "Optional wikilink to a separate long-form document when record content is not sufficient."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "open",
        "paused",
        "filled",
        "cancelled"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "employment_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "compensation_min": {
      "type": [
        "number",
        "null"
      ]
    },
    "compensation_max": {
      "type": [
        "number",
        "null"
      ]
    },
    "compensation_currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "compensation_period": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_start": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "headcount": {
      "type": "number"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional Markdown writing about this record. Use this before creating a separate detail page."
    }
  },
  "additionalProperties": false
}
